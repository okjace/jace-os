#!/bin/sh
# jace-screenshot screen | area
# Saves to ~/Pictures/Screenshots, copies it to the clipboard and shows a notification.
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot $(date '+%Y-%m-%d %H-%M-%S').png"

case "$1" in
  area)
    region=$(slurp -b 00000066 -c 3ddc84 -w 2) || exit 0
    grim -g "$region" "$file" ;;
  *) grim "$file" ;;
esac || exit 1

wl-copy --type image/png < "$file"
action=$(notify-send -a "Screenshot" -i "$file" -A open=Open -A folder="Show in folder" \
  "Screenshot saved" "Copied to the clipboard too.")
case "$action" in
  open) xdg-open "$file" ;;
  folder) thunar "$dir" ;;
esac
