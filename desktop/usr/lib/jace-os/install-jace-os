#!/bin/bash
# Installs Jace OS from the live USB, using archinstall with the Jace OS preset.
# Run by "Install Jace OS" (jace-install), as root.
set -u
G=$'\e[1;38;2;61;220;132m' D=$'\e[2m' R=$'\e[0m'

clear
cat <<BANNER
${G}
      ██
      ██
      ██
 ██   ██
  █████  OS${R}

  ${G}Install Jace OS${R}

  You'll pick:  your language and keyboard, the disk to install on,
                your name and password, and your time zone.
  Already chosen for you:  the Jace OS desktop, Jace Launcher, Jace Social,
                Jace Store, Jace Browser, Wi-Fi, sound and automatic updates.

  ${D}Use the arrow keys and Enter. Choose "Install" at the bottom when you're done.${R}

BANNER

if ! curl -fsI --max-time 10 https://github.com >/dev/null; then
  echo "  You need to be online to install Jace OS."
  echo "  Connect to Wi-Fi with the network icon on the top bar, then try again."
  read -rp "  Press Enter to close." _
  exit 1
fi

read -rp "  Press Enter to start (or close this window to cancel). " _
archinstall --config /usr/share/jace-os/installer/archinstall.json
status=$?

echo
if [ $status -eq 0 ]; then
  echo "  ${G}Jace OS is installed.${R} Restart and take out the USB stick."
  read -rp "  Restart now? [Y/n] " answer
  case "$answer" in n*|N*) ;; *) systemctl reboot ;; esac
else
  echo "  The installer stopped (code $status). Nothing was changed unless you got to the install step."
  read -rp "  Press Enter to close." _
fi
