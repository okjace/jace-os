#!/bin/bash
# Applies what you chose in Setup (jace-setup), the first time Jace OS starts. Runs as root
# through pkexec; the jace-setup user may run it without a password (polkit rule), and it
# only works while setup is pending (/var/lib/jace-os/setup-pending), so it can't be used
# once your computer is set up.
#
#   setup-backend wifi     {"ssid": "...", "password": "..."} on stdin: join a Wi-Fi network
#   setup-backend finish   {"locale", "keyboard", "timezone", "fullname", "username",
#                           "password", "hostname", "dark", "jace"} on stdin: make your account
#                           and apply everything, then sign you in. "jace" (optional) is the
#                           Jace account you signed in to in Setup: {"account", "avatar" (base64)};
#                           "sync" (optional) turns on cloud sync: {"key" (base64), "state"}
#
# finish prints "@progress <percent> <what it's doing>" lines, then "@done" or "@error <why>".
set -euo pipefail

PENDING=/var/lib/jace-os/setup-pending
progress() { echo "@progress $1 $2"; }
fail() { echo "@error $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || exec pkexec "$0" "$@"
case "${1:-}" in wifi|finish) [ -e "$PENDING" ] || fail "Setup has already been done." ;; esac

config=$(cat)
get() { python3 -c 'import json,sys; v=json.loads(sys.argv[1]).get(sys.argv[2], ""); print(str(v).lower() if isinstance(v, bool) else v)' "$config" "$1"; }

case "${1:-}" in
  wifi)
    ssid=$(get ssid)
    password=$(get password)
    [ -n "$ssid" ] || fail "Choose a network."
    if [ -z "$password" ]; then
      nmcli device wifi connect "$ssid" >/dev/null 2>&1 || fail "Couldn't join $ssid."
    else
      # A NetworkManager connection file readable only by root, so the password is never on
      # a command line.
      [[ "$ssid" != *$'\n'* && "$password" != *$'\n'* ]] || fail "That network name or password isn't valid."
      file=/etc/NetworkManager/system-connections/jace-setup-$(date +%s).nmconnection
      umask 077
      printf '[connection]\nid=%s\ntype=wifi\nautoconnect=true\n\n[wifi]\nmode=infrastructure\nssid=%s\n\n[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n' \
        "$ssid" "$ssid" "$password" > "$file"
      nmcli connection load "$file" >/dev/null 2>&1 || nmcli connection reload >/dev/null 2>&1 || true
      if ! nmcli --wait 30 connection up id "$ssid" >/dev/null 2>&1; then
        rm -f "$file"
        nmcli connection reload >/dev/null 2>&1 || true
        fail "Couldn't join $ssid. Check the password."
      fi
    fi
    echo "@done" ;;

  finish)
    locale=$(get locale)
    keyboard=$(get keyboard)
    timezone=$(get timezone)
    fullname=$(get fullname)
    username=$(get username)
    password=$(get password)
    hostname=$(get hostname)
    dark=$(get dark)
    [[ "$username" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "That username isn't valid."
    case "$username" in root|jace-setup|jace-live|greeter|clamav|nobody) fail "Choose a different username." ;; esac
    getent passwd "$username" >/dev/null && fail "There's already an account called $username."
    [[ "$hostname" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || hostname=jace-os
    [ -n "$password" ] || fail "Choose a password."
    [[ "$keyboard" =~ ^[a-z]{2,6}$ ]] || keyboard=us
    [[ "$locale" =~ ^[a-zA-Z_]+\.UTF-8$ ]] || locale=en_US.UTF-8
    [ -e "/usr/share/zoneinfo/$timezone" ] && [[ "$timezone" != *..* ]] || timezone=UTC

    progress 10 "Setting your language"
    sed -i "s/^#\(${locale//./\\.} \)/\1/" /etc/locale.gen
    grep -q "^en_US.UTF-8" /etc/locale.gen || sed -i 's/^#\(en_US\.UTF-8 \)/\1/' /etc/locale.gen
    locale-gen >/dev/null 2>&1 || true
    echo "LANG=$locale" > /etc/locale.conf

    progress 35 "Setting your keyboard and time zone"
    console=$keyboard
    case "$keyboard" in gb) console=uk ;; latam) console=la-latin1 ;; ara|in|cn|jp|kr|il|gr|ru|ua) console=us ;; esac
    old_console=$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf 2>/dev/null || true)
    echo "KEYMAP=$console" > /etc/vconsole.conf
    mkdir -p /etc/X11/xorg.conf.d
    printf 'Section "InputClass"\n  Identifier "system-keyboard"\n  MatchIsKeyboard "on"\n  Option "XkbLayout" "%s"\nEndSection\n' \
      "$keyboard" > /etc/X11/xorg.conf.d/00-keyboard.conf
    ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
    hwclock --systohc >/dev/null 2>&1 || true
    echo "$hostname" > /etc/hostname
    hostname "$hostname" 2>/dev/null || true
    printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' "$hostname" "$hostname" > /etc/hosts
    # An encrypted disk asks for its password before the desktop starts, with the keyboard
    # layout in the start-up files: make them again (in the background) if it changed.
    if grep -q "cryptdevice=" /proc/cmdline && [ "$old_console" != "$console" ]; then
      systemd-run --unit=jace-setup-mkinitcpio --quiet mkinitcpio -P >/dev/null 2>&1 || true
    fi

    progress 60 "Making your account"
    useradd -m -G wheel,video,audio,input,network -s /bin/bash -c "$fullname" "$username"
    printf '%s:%s\n' "$username" "$password" | chpasswd
    home=$(getent passwd "$username" | cut -d: -f6)
    # Made as the new person, not root: a root-owned ~/.config breaks apps (Electron apps
    # can't find their settings folder) and keeps Settings from saving.
    runuser -u "$username" -- mkdir -p "$home/.config/labwc" "$home/.config/jace-os"
    runuser -u "$username" -- sh -c 'echo "XKB_DEFAULT_LAYOUT=$1" > "$2"' sh "$keyboard" "$home/.config/labwc/environment"
    runuser -u "$username" -- env HOME="$home" LANG="$locale" xdg-user-dirs-update >/dev/null 2>&1 || true

    if python3 -c 'import json,sys; sys.exit(0 if json.loads(sys.argv[1]).get("jace") else 1)' "$config"; then
      progress 70 "Signing in to Jace"
      # Written as the new person, readable only by them, where the Jace OS apps look for it.
      printf '%s' "$config" | runuser -u "$username" -- env HOME="$home" python3 -c '
import base64, json, os, sys
from pathlib import Path
jace = json.load(sys.stdin)["jace"]
d = Path(os.environ["HOME"]) / ".local/share/jace-os"
d.mkdir(parents=True, exist_ok=True)
fd = os.open(d / "account.json", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as out:
    json.dump(jace["account"], out, indent=2)
if jace.get("avatar"):
    (d / "avatar").write_bytes(base64.b64decode(jace["avatar"]))
' || true
      # Your Jace picture is your account picture (the login and lock screens show it).
      if [ -s "$home/.local/share/jace-os/avatar" ]; then
        user_path=$(busctl call org.freedesktop.Accounts /org/freedesktop/Accounts org.freedesktop.Accounts \
          FindUserByName s "$username" 2>/dev/null | awk '{print $2}' | tr -d '"')
        [ -n "$user_path" ] && busctl call org.freedesktop.Accounts "$user_path" org.freedesktop.Accounts.User \
          SetIconFile s "$home/.local/share/jace-os/avatar" >/dev/null 2>&1 || true
      fi
    fi

    if python3 -c 'import json,sys; sys.exit(0 if json.loads(sys.argv[1]).get("sync") else 1)' "$config"; then
      progress 75 "Turning on sync"
      # The sync key (readable only by the new person) and what syncs; the first sign-in brings
      # everything in from the Jace account (jace-sync --daemon).
      printf '%s' "$config" | runuser -u "$username" -- env HOME="$home" python3 -c '
import base64, json, os, sys
from pathlib import Path
sync = json.load(sys.stdin)["sync"]
home = Path(os.environ["HOME"])
data = home / ".local/share/jace-os"
conf = home / ".config/jace-os"
data.mkdir(parents=True, exist_ok=True)
conf.mkdir(parents=True, exist_ok=True)
fd = os.open(data / "sync-key", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "wb") as out:
    out.write(base64.b64decode(sync["key"]))
(conf / "sync.json").write_text(json.dumps(sync["state"], indent=2))
' || true
    fi

    progress 80 "Choosing your look"
    scheme=prefer-dark theme=adw-gtk3-dark
    [ "$dark" = false ] && scheme=default theme=adw-gtk3
    runuser -u "$username" -- env HOME="$home" dbus-run-session sh -c \
      "gsettings set org.gnome.desktop.interface color-scheme $scheme; gsettings set org.gnome.desktop.interface gtk-theme $theme" \
      >/dev/null 2>&1 || true

    progress 95 "Finishing up"
    # Everything in the new home folder belongs to its person, whatever made it.
    chown -R "$username:$username" "$home"
    chmod 700 "$home"
    chmod 755 "$home/.config"
    rm -f "$PENDING"
    # Sign straight in to the new account this once (greetd-start uses this file one time).
    mkdir -p /run/jace-os
    sed -n '1,/^\[initial_session\]/p' /etc/greetd/jace-os.toml | sed '/^\[initial_session\]/d' > /run/jace-os/greetd-once.toml
    printf '\n[initial_session]\ncommand = "jace-session"\nuser = "%s"\n' "$username" >> /run/jace-os/greetd-once.toml
    progress 100 "Done"
    echo "@done" ;;

  signin)
    # After "Get started": restart the login screen, which signs you in (see finish).
    [ -e /run/jace-os/greetd-once.toml ] || fail "Setup isn't finished."
    systemd-run --on-active=1 --quiet systemctl restart greetd.service ;;

  *)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
