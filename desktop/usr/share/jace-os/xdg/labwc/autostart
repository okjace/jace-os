# Started by labwc when a Jace OS session begins.
# Put your own commands in ~/.config/labwc/autostart (that file replaces this one,
# so start it with: . /usr/share/jace-os/xdg/labwc/autostart).

# Let D-Bus activated apps and portals see the Wayland session.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP >/dev/null 2>&1
systemctl --user start xdg-desktop-portal.service >/dev/null 2>&1 &

# Desktop, Documents, Downloads, Music, Pictures, Videos… in your home folder (only makes missing ones).
xdg-user-dirs-update >/dev/null 2>&1

jace-wallpaper restore >/dev/null 2>&1 &
# The top bar, built from Settings → Top bar.
jace-bar >/dev/null 2>&1 &
mako --config "$(jace-config-path mako/config)" >/dev/null 2>&1 &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &
nm-applet --indicator >/dev/null 2>&1 &
blueman-applet >/dev/null 2>&1 &
# Clipboard history for Win+V (unless turned off in Settings → Keyboard & mouse).
[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/jace-os/clipboard-off" ] || wl-paste --watch cliphist store >/dev/null 2>&1 &
jace-idle >/dev/null 2>&1 &
jace-menu --daemon >/dev/null 2>&1 &
# The apps that come with Jace OS, as custom apps in Jace Store's My apps (once each).
jace-my-apps >/dev/null 2>&1 &
# Alerts when virus protection finds something.
jace-av-notify >/dev/null 2>&1 &

# Your display settings and night light from Settings → Display.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/jace-os"
[ -r "$conf/displays" ] && sh "$conf/displays" >/dev/null 2>&1
[ -e "$conf/nightlight" ] && wlsunset -t 4000 -T 6500 -S 07:00 -s 20:00 >/dev/null 2>&1 &

# On the live USB: open the installer, or offer to (installed systems: does nothing).
/usr/lib/jace-os/live-start >/dev/null 2>&1 &

# One-time changes after an update (Jace Browser became the default browser).
jace-migrate >/dev/null 2>&1 &
# Empties old trash (if you turned that on) and warns when a drive is nearly full.
jace-storage --auto >/dev/null 2>&1 &
