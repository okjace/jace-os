<?xml version="1.0" encoding="UTF-8"?>
<!-- The right-click menus: on the desktop (root-menu) and on a title bar (client-menu). -->
<openbox_menu>

  <menu id="client-menu">
    <item label="Minimize"><action name="Iconify" /></item>
    <item label="Maximize"><action name="ToggleMaximize" /></item>
    <item label="Snap left"><action name="SnapToEdge" direction="left" /></item>
    <item label="Snap right"><action name="SnapToEdge" direction="right" /></item>
    <item label="Always on top"><action name="ToggleAlwaysOnTop" /></item>
    <menu id="client-send-to-menu" label="Move to desktop" />
    <separator />
    <item label="Close"><action name="Close" /></item>
  </menu>

  <menu id="root-menu">
    <item label="Open apps"><action name="Execute" command="jace-menu" /></item>
    <item label="Terminal"><action name="Execute" command="foot" /></item>
    <item label="Files"><action name="Execute" command="thunar" /></item>
    <separator />
    <item label="Change wallpaper"><action name="Execute" command="jace-settings --page appearance" /></item>
    <item label="Display settings"><action name="Execute" command="wdisplays" /></item>
    <item label="Settings"><action name="Execute" command="jace-settings" /></item>
    <separator />
    <item label="Lock"><action name="Execute" command="jace-lock" /></item>
    <item label="Power"><action name="Execute" command="jace-power" /></item>
  </menu>

</openbox_menu>
