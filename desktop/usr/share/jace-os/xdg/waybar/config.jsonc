// Jace OS top bar (Waybar). Inspired by niri's bar: a thin strip of floating
// "islands": start button, desktops and open windows on the left, the clock in
// the middle, status and your Jace account on the right.
// Copy to ~/.config/waybar/config.jsonc to change it for yourself.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 6,
  "exclusive": true,

  "modules-left": ["custom/start", "ext/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "custom/updates", "pulseaudio", "network", "bluetooth", "battery", "custom/jace", "custom/power"],

  "custom/start": {
    "format": "J",
    "tooltip-format": "Start (Windows key)",
    "on-click": "jace-menu",
    "on-click-right": "jace-settings"
  },

  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "on-click-right": "maximize",
    "ignore-list": ["Waybar"]
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "format-alt": "{:%A, %B %d %Y  %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<span color='#3ddc84'><b>{}</b></span>" }
    }
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "custom/updates": {
    "exec": "jace-updates --waybar",
    "return-type": "json",
    "interval": 1800,
    "signal": 8,
    "format": "{}",
    "on-click": "jace-settings --page updates"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
    "scroll-step": 5,
    "on-click": "jace-settings --page sound",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
    "on-click": "jace-settings --page network"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "jace-settings --page bluetooth"
  },

  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "on-click": "jace-settings --page power"
  },

  "custom/jace": {
    "exec": "jace-account --waybar",
    "return-type": "json",
    "interval": 300,
    "signal": 9,
    "format": "{}",
    "on-click": "jace-settings --page account"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Lock, sleep, restart or shut down",
    "on-click": "jace-power"
  }
}
