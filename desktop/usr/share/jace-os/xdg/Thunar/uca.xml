<?xml version="1.0" encoding="UTF-8"?>
<!-- Jace OS right-click actions in Files (Thunar). Yours go in ~/.config/Thunar/uca.xml. -->
<actions>
<action>
	<icon>system-software-install</icon>
	<name>Install</name>
	<submenu></submenu>
	<unique-id>jace-os-appimage-install</unique-id>
	<command>jace-appimage install %f</command>
	<description>Install this AppImage: it goes in Applications and the start menu</description>
	<range>1-1</range>
	<patterns>*.AppImage;*.appimage</patterns>
	<other-files/>
</action>
<action>
	<icon>media-playback-start</icon>
	<name>Open AppImage</name>
	<submenu></submenu>
	<unique-id>jace-os-appimage-open</unique-id>
	<command>jace-appimage open %f</command>
	<description>Run this AppImage</description>
	<range>1-1</range>
	<patterns>*.AppImage;*.appimage</patterns>
	<other-files/>
</action>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>jace-os-terminal-here</unique-id>
	<command>foot --working-directory %f</command>
	<description>Open a terminal in this folder</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
</action>
</actions>
