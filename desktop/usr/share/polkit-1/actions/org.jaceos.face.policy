<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Jace OS</vendor>
  <vendor_url>https://okjace.github.io/jace-os/</vendor_url>
  <!-- Changes how you sign in, so it always asks for your password (no wheel shortcut). -->
  <action id="org.jaceos.face">
    <description>Change face unlock</description>
    <message>Changing face unlock needs your password</message>
    <icon_name>camera-web</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/jace-face</annotate>
  </action>
</policyconfig>
