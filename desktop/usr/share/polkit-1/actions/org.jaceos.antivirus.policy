<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Jace OS</vendor>
  <vendor_url>https://okjace.github.io/jace-os/</vendor_url>
  <action id="org.jaceos.antivirus">
    <description>Change Jace OS virus protection</description>
    <message>Changing virus protection needs your password</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/jace-av</annotate>
  </action>
</policyconfig>
