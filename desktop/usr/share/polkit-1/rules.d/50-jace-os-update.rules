// Administrators (the wheel group) can install updates and manage virus protection
// from Settings without typing a password.
polkit.addRule(function (action, subject) {
  if ((action.id == "org.jaceos.update" || action.id == "org.jaceos.antivirus") &&
      subject.active && subject.local && subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }
});
