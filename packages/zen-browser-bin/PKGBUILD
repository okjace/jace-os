# Maintainer: Jace <https://github.com/okjace>
# Zen Browser for Jace OS: the official Linux build from zen-browser/desktop.
# tools/build-packages.sh sets _tag to the newest release.
pkgname=zen-browser-bin
_tag=1.24b
pkgver=${_tag//-/_}
pkgrel=1
pkgdesc="Zen Browser: a calm, fast Firefox-based web browser"
arch=(x86_64)
url="https://zen-browser.app"
license=(MPL-2.0)
depends=(gtk3 libxt mailcap dbus-glib nss ttf-font alsa-lib)
optdepends=('ffmpeg: video playback' 'libnotify: notifications' 'xdg-desktop-portal: file pickers')
provides=(zen-browser)
conflicts=(zen-browser)
options=(!strip !debug)
source=("zen-${_tag}.tar.xz::https://github.com/zen-browser/desktop/releases/download/${_tag}/zen.linux-x86_64.tar.xz")
sha256sums=('SKIP')

package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/bin"
  cp -a zen "$pkgdir/opt/zen-browser"
  ln -s /opt/zen-browser/zen "$pkgdir/usr/bin/zen-browser"

  # Jace OS defaults: no default-browser nagging, no update prompts (pacman updates it).
  install -Dm644 /dev/stdin "$pkgdir/opt/zen-browser/distribution/policies.json" <<'POLICIES'
{
  "policies": {
    "DisableAppUpdate": true,
    "DontCheckDefaultBrowser": true
  }
}
POLICIES

  for size in 16 32 48 64 128; do
    [ -f "zen/browser/chrome/icons/default/default${size}.png" ] &&
      install -Dm644 "zen/browser/chrome/icons/default/default${size}.png" \
        "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/zen.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/zen.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Zen Browser
GenericName=Web Browser
Comment=Browse the web
Exec=zen-browser %u
Icon=zen
Terminal=false
Type=Application
StartupWMClass=zen
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/x-xpinstall;application/pdf;
Categories=Network;WebBrowser;
Keywords=internet;web;browser;zen;firefox;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=zen-browser --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=zen-browser --private-window %u
DESKTOP
}
