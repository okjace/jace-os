# Maintainer: Jace <https://github.com/okjace>
# Jace Browser for Jace OS: the official Linux build from okjace/jace-browser, the default
# browser on Jace OS. tools/build-packages.sh sets pkgver to the newest release.
pkgname=jace-browser-bin
pkgver=1.0.1
pkgrel=1
pkgdesc="Jace Browser: a Firefox-based browser with a Zen-style look, Jace accounts and sync"
arch=(x86_64)
url="https://github.com/okjace/jace-browser"
license=(MPL-2.0)
depends=(gtk3 libxt mailcap dbus-glib nss ttf-font alsa-lib)
optdepends=('ffmpeg: video playback' 'libnotify: notifications' 'xdg-desktop-portal: file pickers')
provides=(jace-browser)
conflicts=(jace-browser)
options=(!strip !debug)
source=("JaceBrowser-${pkgver}.tar.xz::https://github.com/okjace/jace-browser/releases/download/v${pkgver}/JaceBrowser-${pkgver}-linux-x86_64.tar.xz")
sha256sums=('SKIP')

package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/bin"
  cp -a jace "$pkgdir/opt/jace-browser"

  # Jace OS keeps it up to date with pacman, so its own updater has nothing to do.
  install -Dm644 /dev/stdin "$pkgdir/opt/jace-browser/defaults/pref/jace-os.js" <<'PREFS'
// Jace OS defaults for Jace Browser
pref("app.update.auto", false);
pref("app.update.background.enabled", false);
PREFS

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/jace-browser" <<'WRAPPER'
#!/bin/sh
exec /opt/jace-browser/jace "$@"
WRAPPER

  for size in 16 32 48 64 128; do
    [ -f "jace/browser/chrome/icons/default/default${size}.png" ] || continue
    install -Dm644 "jace/browser/chrome/icons/default/default${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/jace-browser.png"
  done

  # Its windows say they're "jace" (the app name it's built with): StartupWMClass lets the
  # top bar find this entry, and its icon, for them.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/jace-browser.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Jace Browser
GenericName=Web Browser
Comment=Browse the web with your Jace account
Exec=jace-browser %u
Icon=jace-browser
Terminal=false
Type=Application
StartupWMClass=jace
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/x-xpinstall;application/pdf;
Categories=Network;WebBrowser;
Keywords=internet;web;browser;jace;firefox;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=jace-browser --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=jace-browser --private-window %u
DESKTOP
}
