post_install() {
  # Turn on the login screen, automatic updates, Wi-Fi, Bluetooth and power modes.
  systemctl enable greetd.service jace-update.timer NetworkManager.service \
    bluetooth.service power-profiles-daemon.service >/dev/null 2>&1
  # Virus protection: signatures, real-time protection (starts once signatures are in) and daily scans.
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/jace-os.conf >/dev/null 2>&1
  systemctl enable clamav-freshclam.service jace-av-ready.path clamav-daemon.socket \
    clamav-daemon.service clamav-clamonacc.service jace-av-scan.timer >/dev/null 2>&1
  install -m644 /usr/lib/jace-os/os-release /etc/os-release
  # The boot splash; the installer runs this again once the bootloader exists.
  /usr/lib/jace-os/enable-splash >/dev/null 2>&1 || true
}

# Older versions of Setup left ~/.config owned by root, which breaks apps (Electron apps
# can't find their settings folder). Give each person's ~/.config, ~/.local and ~/.cache,
# and anything root made directly inside them, back to them.
fix_homes() {
  local name uid home d
  while IFS=: read -r name _ uid _ _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [[ "$home" == /home/* ]] && [ -d "$home" ] || continue
    for d in "$home/.config" "$home/.local" "$home/.cache"; do
      [ -d "$d" ] || continue
      [ "$(stat -c %u "$d")" = "$uid" ] || chown "$name:" "$d"
      find "$d" -mindepth 1 -maxdepth 1 -uid 0 -exec chown -R "$name:" {} + 2>/dev/null
    done
  done < /etc/passwd
}

post_upgrade() {
  fix_homes
  install -m644 /usr/lib/jace-os/os-release /etc/os-release
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/jace-os.conf >/dev/null 2>&1
  plymouth-set-default-theme jace-os >/dev/null 2>&1 || true
  # Face unlock: make sure your face is tried before the password (older versions put it after).
  for s in $(/usr/bin/jace-face status 2>/dev/null | awk '$2 == "on" {print $1}'); do
    /usr/bin/jace-face enable "$s" >/dev/null 2>&1 || true
  done
}

post_remove() {
  systemctl disable jace-update.timer jace-av-scan.timer jace-av-ready.path >/dev/null 2>&1 || true
}
